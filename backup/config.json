{
    "proxy": { "host": "127.0.0.1", "port": 7890, "type": "socks5" },
    "fake_ip": { "enabled": false, "cidr": "198.18.0.0/15" },
    "child_injection": false,
    "child_injection_mode": "filtered",
    "target_processes": ["language_server.exe", "language_server_windows", "node.exe"],
    "hook_delay_ms": 3000,
    "skip_iocp_hooks": true,
    "skip_traffic_hooks": false,
    "proxy_rules": {
        "allowed_ports": [80, 443],
        "dns_mode": "direct",
        "ipv6_mode": "proxy",
        "udp_mode": "block",
        "udp_fallback": "block"
    },
    "timeout": { "connect": 5000, "send": 5000, "recv": 5000 },
    "log_level": "info",
    "traffic_logging": false
}
