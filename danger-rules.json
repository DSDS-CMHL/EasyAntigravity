{
  "version": 1,
  "enabled": true,
  "_comment": "高危命令自动放行熔断规则（类似 VPN rules）。pattern 为正则，默认不区分大小写。enabled=false 停用整组或单条。改完点「重载规则」或重启 EasyAG。",
  "rules": [
    {
      "id": "rm-rf",
      "name": "递归强制删除",
      "description": "rm 含递归或强制参数（支持 -rf、-fr、拆分参数和长参数）",
      "pattern": "\\brm(?:\\s+(?:--(?:recursive|force)|-[a-zA-Z]*[rf][a-zA-Z]*)){1,4}(?=\\s|$)",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "windows-del",
      "name": "Windows 强制删除",
      "description": "del/rd/rmdir 带 /s /q /f",
      "pattern": "\\b(del|rd|rmdir)\\s+.*\\/[sqf]",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "disk-wipe",
      "name": "磁盘破坏",
      "description": "format / diskpart / mkfs / wipefs / shred",
      "pattern": "\\b(format|diskpart|mkfs|wipefs|shred)\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "sql-drop",
      "name": "数据库删除",
      "description": "DROP DATABASE / TABLE",
      "pattern": "\\bdrop\\s+(database|table)\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "git-force-push",
      "name": "Git 强制推送",
      "description": "git push --force / -f",
      "pattern": "\\bgit\\s+push\\s+.*(-f|--force)\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "shutdown",
      "name": "关机/停止计算机",
      "description": "shutdown / stop-computer",
      "pattern": "\\b(shutdown|stop-computer)\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "sudo-rm",
      "name": "sudo 删除",
      "description": "sudo rm ...",
      "pattern": "\\bsudo\\s+.*\\brm\\s+",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "dd-disk",
      "name": "dd 写裸盘",
      "description": "dd of=/dev/sdX",
      "pattern": "\\bdd\\s+.*of=/dev/",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "chmod-777-root",
      "name": "根目录 777",
      "description": "chmod 777 /",
      "pattern": "\\bchmod\\s+(-R\\s+)?777\\s+/",
      "flags": "i",
      "enabled": true
    }
  ]
}
