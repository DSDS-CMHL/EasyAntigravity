{
    "name":  "easyantigravity",
    "version":  "2.0.1",
    "description":  "Antigravity launcher: native no-TUN proxy, I18N, auto-accept",
    "main":  "server.js",
    "bin":  "server.js",
    "scripts":  {
                    "start":  "node server.js",
                    "test:danger-rules":  "node test/danger-rules.test.js",
                    "test:approval-lifecycle":  "node test/approval-lifecycle.test.js",
                    "build":  "npx --yes pkg@5.8.1 server.js --targets node18-win-x64 --output EasyAntigravity.exe --compress GZip"
                },
    "pkg":  {
                "options":  [
                                "no-warnings"
                            ]
            },
    "keywords":  [
                     "antigravity",
                     "proxy",
                     "launcher"
                 ],
    "author":  "",
    "license":  "ISC",
    "type":  "commonjs",
    "dependencies":  {
                         "ws":  "^8.21.3"
                     }
}
