{
  "name": "easyantigravity",
  "version": "4.0.1",
  "description": "Antigravity lightweight launcher: process proxy, reversible localization and context ring",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/check.cjs",
    "build:manifest": "node scripts/build-update-manifest.cjs",
    "test": "node test/i18n-revert.test.js && node --test test/core.test.cjs test/cdp.test.cjs test/context-monitor.test.cjs test/context-widget.test.cjs test/backend-resources.test.cjs && node test/foundation.test.cjs",
    "test:core": "node --test test/core.test.cjs test/cdp.test.cjs test/context-monitor.test.cjs test/backend-resources.test.cjs",
    "test:context": "node --test test/context-monitor.test.cjs test/context-widget.test.cjs",
    "test:context:browser": "node test/context-browser.cjs",
    "test:i18n-revert": "node test/i18n-revert.test.js",
    "test:tauri-lifecycle": "node test/tauri-lifecycle.test.cjs",
    "tauri": "tauri"
  },
  "keywords": [
    "antigravity",
    "proxy",
    "launcher"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=22"
  }
}
