{
  "pack": "easyag-danger-core",
  "version": 3,
  "updated_at": "2026-09-26T05:22:43.298Z",
  "rules": [
    {
      "id": "rm-rf",
      "name": "递归强制删除",
      "description": "rm 含递归或强制参数（支持 -rf、-fr、拆分参数和长参数）",
      "pattern": "\\brm(?:\\s+(?:--(?:recursive|force)|-[a-zA-Z]*[rf][a-zA-Z]*)){1,4}(?=\\s|$)",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "windows-del",
      "name": "Windows 强制删除",
      "description": "del/rd/rmdir/Remove-Item 带递归强制或 /s /q /f",
      "pattern": "\\b(del|rd|rmdir|erase)\\s+.*\\/[sqf]|\\bRemove-Item\\b.*-(?:Recurse|Force)\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "disk-wipe",
      "name": "磁盘破坏",
      "description": "format 盘符 / format-volume / diskpart / mkfs / wipefs / shred",
      "pattern": "\\bformat(?:\\.com)?\\s+[A-Za-z]:|\\bFormat-Volume\\b|\\bdiskpart\\b|\\bmkfs(?:\\.|\\b)|\\bwipefs\\b|\\bshred\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "raw-disk-write",
      "name": "裸盘写入",
      "description": "dd of=/dev/... 或 \\Device\\Harddisk 写镜像",
      "pattern": "\\bdd\\s+.*of=/dev/|\\\\Device\\\\Harddisk",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "sql-drop",
      "name": "数据库删除",
      "description": "DROP DATABASE / TABLE / TRUNCATE",
      "pattern": "\\bdrop\\s+(database|table)\\b|\\btruncate\\s+table\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "git-destructive",
      "name": "Git 破坏性操作",
      "description": "force push / reset --hard / clean -fdx",
      "pattern": "\\bgit\\s+push\\s+.*(-f|--force)\\b|\\bgit\\s+reset\\s+--hard\\b|\\bgit\\s+clean\\s+-[a-zA-Z]*[fxd]",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "find-delete",
      "name": "find -delete / -exec rm",
      "description": "find 结合 -delete 或 -exec rm，易通配符展开误删",
      "pattern": "\\bfind\\b[\\s\\S]*-delete\\b|\\bfind\\b[\\s\\S]*-exec\\s+rm\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "shutdown",
      "name": "关机/停止计算机",
      "description": "shutdown / stop-computer / restart-computer / logoff",
      "pattern": "\\b(shutdown|stop-computer|restart-computer|logoff)\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "sudo-rm",
      "name": "sudo 删除",
      "description": "sudo rm ... 或 sudo 裸盘类",
      "pattern": "\\bsudo\\s+.*\\brm\\s+|\\bsudo\\s+.*\\bdd\\s+",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "chmod-777-root",
      "name": "根目录 777 / chown 递归根",
      "description": "chmod 777 / 或 chown -R 到根",
      "pattern": "\\bchmod\\s+(-R\\s+)?777\\s+/|\\bchown\\s+-R\\s+[^\\s]+\\s+/$",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "dangerous-download-exec",
      "name": "下载即执行",
      "description": "curl|bash / wget|sh / IEX / Invoke-Expression 下载执行",
      "pattern": "\\b(curl|wget)\\b[^|\\n]*\\|\\s*(bash|sh|zsh|pwsh|powershell)\\b|\\b(iex|Invoke-Expression)\\b.*\\b(curl|wget|Invoke-WebRequest|iwr)\\b|\\b(curl|wget|iwr|Invoke-WebRequest)\\b[\\s\\S]*\\b(iex|Invoke-Expression)\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "certutil-bitsadmin",
      "name": "certutil / bitsadmin 侧载",
      "description": "certutil -urlcache / bitsadmin transfer 下载载荷",
      "pattern": "\\bcertutil\\b[\\s\\S]*-urlcache|\\bbitsadmin\\b[\\s\\S]*\\/transfer",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "windows-boot-hijack",
      "name": "引导/注册表破坏",
      "description": "bcdedit、reg delete 关键键、sc delete 系统服务",
      "pattern": "\\bbcdedit\\b|\\breg\\s+delete\\s+HKLM\\\\|\\bsc\\s+delete\\s+",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "account-escalation",
      "name": "账户提权/后门账号",
      "description": "net user /add、localgroup administrators 添加",
      "pattern": "\\bnet\\s+user\\s+\\S+\\s+/add|\\bnet\\s+localgroup\\s+administrators\\s+",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "robocopy-mir",
      "name": "robocopy /MIR 镜像抹除",
      "description": "robocopy /MIR 会把目标目录同步成源目录（删除目标多余文件）",
      "pattern": "\\brobocopy\\b[\\s\\S]*/mir\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "ssh-key-wipe",
      "name": "SSH/凭据目录破坏",
      "description": "删除 .ssh / id_rsa / credentials 等敏感路径",
      "pattern": "\\b(rm|del|Remove-Item)\\b[\\s\\S]*(\\.ssh|id_rsa|id_ed25519|credentials|\\.aws|\\.npmrc|\\.netrc)",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "pip-npm-remote-script",
      "name": "包管理器执行远程脚本",
      "description": "npm i -g 后 pipe 执行 / pip install 并 run 恶意入口（粗匹配）",
      "pattern": "\\bnpm\\s+(i|install)\\b[\\s\\S]*\\|\\s*(node|sh|bash)|\\bpip\\s+install\\s+\\S*://",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "fork-bomb",
      "name": "Fork 炸弹",
      "description": ":(){ :|:& };: 类",
      "pattern": ":\\(\\)\\s*\\{\\s*:\\s*\\|\\s*:\\s*&\\s*\\}\\s*;\\s*:",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "ps-wipe",
      "name": "PowerShell 递归强删",
      "description": "PowerShell 递归强删",
      "pattern": "\\bRemove-Item\\b[\\s\\S]*-Recurse\\b[\\s\\S]*-Force\\b|\\brm\\b[\\s\\S]*-Recurse\\b[\\s\\S]*-Force\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "del-star",
      "name": "通配符批量删除",
      "description": "通配符批量删除",
      "pattern": "\\b(del|erase|rm)\\b[^\\n]*\\*[\\w]*",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "shred-secure",
      "name": "安全擦除 shred",
      "description": "安全擦除 shred",
      "pattern": "\\bshred\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "move-root",
      "name": "移动/重命名到根",
      "description": "移动/重命名到根",
      "pattern": "\\b(mv|move|ren|rename)\\b[^\\n]*(^|\\s)/\\s*$|\\b(mv|move)\\b[^\\n]*[A-Za-z]:\\\\\\s*$",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "truncate-file",
      "name": "文件清空",
      "description": "文件清空",
      "pattern": "\\btruncate\\b|\\bSet-Content\\b[^\\n]*-Value\\s+['\"]{2}",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "hardlink-abuse",
      "name": "硬链接/联接批量",
      "description": "硬链接/联接批量",
      "pattern": "\\b(mklink|ln)\\b[^\\n]*(/h|/j|hard)",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "overwrite-exe",
      "name": "覆盖系统 exe/dll",
      "description": "覆盖系统 exe/dll",
      "pattern": "\\b(copy|xcopy|robocopy|Copy-Item)\\b[^\\n]*\\.(exe|dll|sys)\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "format-any",
      "name": "格式化卷/磁盘工具",
      "description": "格式化任意卷",
      "pattern": "\\bformat(?:\\.com)?\\s+[A-Za-z]:|\\bFormat-Volume\\b|\\bmkfs(?:\\.|\\b)|\\bdiskpart\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "diskpart-script",
      "name": "diskpart 脚本",
      "description": "diskpart 脚本",
      "pattern": "\\bdiskpart\\b[^\\n]*/s\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "clear-disk",
      "name": "清盘 Clear-Disk",
      "description": "清盘 Clear-Disk",
      "pattern": "\\bClear-Disk\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "initialize-disk",
      "name": "初始化磁盘",
      "description": "初始化磁盘",
      "pattern": "\\bInitialize-Disk\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "remove-partition",
      "name": "删除分区",
      "description": "删除分区",
      "pattern": "\\bRemove-Partition\\b|\\bdelete\\s+partition\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "vss-wipe",
      "name": "删卷影副本",
      "description": "删卷影副本",
      "pattern": "\\bvssadmin\\b[\\s\\S]*delete|\\bwmic\\b[\\s\\S]*shadowcopy[\\s\\S]*delete",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "backup-delete",
      "name": "删备份",
      "description": "删备份",
      "pattern": "\\bwbadmin\\b[\\s\\S]*delete|\\bBackup-Image\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "cipher-wipe",
      "name": "cipher 擦除",
      "description": "cipher 擦除",
      "pattern": "\\bcipher\\b[^\\n]*/w:",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "fsutil-behavior",
      "name": "fsutil 改系统行为",
      "description": "fsutil 改系统行为",
      "pattern": "\\bfsutil\\b[\\s\\S]*(?:behavior|dirty|file)",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "chmod-777",
      "name": "危险 chmod",
      "description": "危险 chmod",
      "pattern": "\\bchmod\\s+(?:-R\\s+)?(?:777|0777|a\\+rwx)",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "chown-root",
      "name": "chown 递归 root",
      "description": "chown 递归 root",
      "pattern": "\\bchown\\s+-R\\s+\\S+\\s+/",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "takeown-icacls",
      "name": "夺权 takeown/icacls",
      "description": "夺权 takeown/icacls",
      "pattern": "\\b(takeown|icacls)\\b[^\\n]*(?:/grant|/setowner)",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "net-user",
      "name": "net 用户管理",
      "description": "net 用户管理",
      "pattern": "\\bnet\\s+user\\b|\\bnet\\s+localgroup\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "add-admin-pwsh",
      "name": "PS 加管理员",
      "description": "PS 加管理员",
      "pattern": "\\bAdd-LocalGroupMember\\b|\\bnet\\s+localgroup\\s+administrators\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "passwd-change",
      "name": "改密码",
      "description": "改密码",
      "pattern": "\\b(passwd|net\\s+user\\s+\\S+\\s+\\*)\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "sudo-all",
      "name": "sudo 全开",
      "description": "sudo 全开",
      "pattern": "\\bsudo\\s+(?:-i|-s|su)\\b|\\bsudo\\s+.*\\b(bash|sh|zsh)\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "sudoers-edit",
      "name": "改 sudoers",
      "description": "改 sudoers",
      "pattern": ">>?\\s*/etc/sudoers|\\bvisudo\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "taskkill-force",
      "name": "强杀进程",
      "description": "强杀进程",
      "pattern": "\\btaskkill\\b[^\\n]*/f|\\bStop-Process\\b[^\\n]*-Force",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "kill-9",
      "name": "kill -9",
      "description": "kill -9",
      "pattern": "\\bkill\\s+-9\\b|\\bkillall\\b|\\bpkill\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "service-stomp",
      "name": "服务创建/改路径",
      "description": "服务创建/改路径",
      "pattern": "\\bsc\\b[\\s\\S]*(?:create|config|start)|\\bNew-Service\\b|\\bSet-Service\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "schtasks",
      "name": "计划任务",
      "description": "计划任务",
      "pattern": "\\bschtasks\\b|\\bRegister-ScheduledTask\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "wmi-exec",
      "name": "WMI/CIM 起进程",
      "description": "WMI/CIM 起进程",
      "pattern": "\\bwmic\\b[\\s\\S]*process[\\s\\S]*call|\\bInvoke-CimMethod\\b[\\s\\S]*Create|\\bInvoke-WmiMethod\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "netsh-proxy",
      "name": "netsh 端口代理/防火墙",
      "description": "netsh 端口代理/防火墙",
      "pattern": "\\bnetsh\\b[\\s\\S]*(?:portproxy|advfirewall)",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "firewall-off",
      "name": "关防火墙",
      "description": "关防火墙",
      "pattern": "\\b(ufw|iptables|netsh)\\b[^\\n]*(?:disable|stop)|Set-NetFirewallProfile[^\\n]*Enabled\\s+False",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "curl-pipe",
      "name": "下载即执行",
      "description": "下载即执行",
      "pattern": "\\b(curl|wget|iwr|irm|Invoke-WebRequest)\\b[^|\\n]*\\||\\b(iex|Invoke-Expression)\\b[\\s\\S]*(?:curl|wget|DownloadString|iwr)",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "certutil-bits",
      "name": "certutil/bitsadmin 下载",
      "description": "certutil/bitsadmin 下载",
      "pattern": "\\b(certutil|bitsadmin|expand|esentutl)\\b[\\s\\S]*(?:urlcache|transfer|http|download)",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "nc-reverse",
      "name": "反弹 shell",
      "description": "反弹 shell",
      "pattern": "\\b(nc|ncat|netcat|socat)\\b[^\\n]*(?:-e|exec|system)|\\bssh\\b[^\\n]*-R\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "ps-enc",
      "name": "PowerShell -enc",
      "description": "PowerShell -enc",
      "pattern": "\\bpowershell\\b[^\\n]*-e(?:nc\\w*)?\\s+[A-Za-z0-9+/=]{16,}",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "ps-hidden",
      "name": "隐藏窗口执行",
      "description": "隐藏窗口执行",
      "pattern": "\\bpowershell\\b[^\\n]*-w(?:indowstyle)?\\s*hidden|\\bpowershell\\b[^\\n]*-nop\\b[^\\n]*-noni\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "iex-cradle",
      "name": "IEX 摇篮",
      "description": "IEX 摇篮",
      "pattern": "\\b(iex|Invoke-Expression)\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "mshta-lol",
      "name": "mshta/rundll32/regsvr32",
      "description": "mshta/rundll32/regsvr32",
      "pattern": "\\b(mshta|rundll32|regsvr32|cmstp|installutil|msbuild)\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "script-host",
      "name": "脚本宿主",
      "description": "脚本宿主",
      "pattern": "\\b(cscript|wscript|wscript\\.shell)\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "git-force",
      "name": "git 破坏性",
      "description": "git 破坏性",
      "pattern": "\\bgit\\s+push\\s+[^\\n]*(--force|-f)\\b|\\bgit\\s+reset\\s+--hard\\b|\\bgit\\s+clean\\s+-[a-zA-Z]*[fxd]|\\bgit\\s+checkout\\s+--\\s+\\.",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "git-filter",
      "name": "git 历史改写",
      "description": "git 历史改写",
      "pattern": "\\bgit\\s+filter-branch\\b|\\bfilter-repo\\b|\\bgit\\s+push\\s+[^\\n]*--force-with-lease[^\\n]*--force\\b",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "sql-destructive",
      "name": "SQL 破坏",
      "description": "SQL 破坏",
      "pattern": "\\bdrop\\s+(database|table|schema)\\b|\\btruncate\\s+table\\b|\\bdelete\\s+from\\s+\\w+\\s*;?\\s*$",
      "flags": "i",
      "enabled": true
    },
    {
      "id": "sql-shutdown",
      "name": "SQL 停库",
      "description": "SQL 停库",
      "pattern": "\\bshutdown\\b[^\\n]*(?:immediate|abort)|\\bALTER\\s+DATABASE\\b[^\\n]*SET\\s+OFFLINE",
